<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="14dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <TextView android:id="@+id/head" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:text="B12 · Bugün" android:textColor="#FF8AB4FF" android:textSize="14sp" android:textStyle="bold" />
        <TextView android:id="@+id/streak" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFECEFF4" android:textSize="13sp" />
    </LinearLayout>
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingTop="10dp" android:text="Bugün iş yok 🎉" android:textColor="#FF96A0AE" android:textSize="13sp" android:visibility="gone" />
    <LinearLayout android:id="@+id/row0" android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/title0" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFECEFF4" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/count0" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF96A0AE" android:textSize="12sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/check0" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
            android:text="✓" android:textSize="16sp" android:textStyle="bold" android:textColor="#FF8AB4FF" android:background="@drawable/check_off" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row1" android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/title1" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFECEFF4" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/count1" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF96A0AE" android:textSize="12sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/check1" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
            android:text="✓" android:textSize="16sp" android:textStyle="bold" android:textColor="#FF8AB4FF" android:background="@drawable/check_off" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row2" android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/title2" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFECEFF4" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/count2" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF96A0AE" android:textSize="12sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/check2" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
            android:text="✓" android:textSize="16sp" android:textStyle="bold" android:textColor="#FF8AB4FF" android:background="@drawable/check_off" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row3" android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/title3" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFECEFF4" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/count3" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF96A0AE" android:textSize="12sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/check3" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
            android:text="✓" android:textSize="16sp" android:textStyle="bold" android:textColor="#FF8AB4FF" android:background="@drawable/check_off" />
    </LinearLayout>
    <LinearLayout android:id="@+id/row4" android:layout_width="match_parent" android:layout_height="40dp"
        android:orientation="horizontal" android:gravity="center_vertical" android:visibility="gone">
        <TextView android:id="@+id/title4" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:textColor="#FFECEFF4" android:textSize="14sp" android:maxLines="1" android:ellipsize="end" />
        <TextView android:id="@+id/count4" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FF96A0AE" android:textSize="12sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/check4" android:layout_width="32dp" android:layout_height="32dp" android:gravity="center"
            android:text="✓" android:textSize="16sp" android:textStyle="bold" android:textColor="#FF8AB4FF" android:background="@drawable/check_off" />
    </LinearLayout>
</LinearLayout>
